<li id="task-{{ task.id }}" class="task-item task-view{% if task.completed %} completed{% endif %}">
  <div class="task-content">
    <span class="task-title">{{ task.title }}</span>
  </div>

  <div class="task-actions">
    <form action="/tasks/{{ task.id }}/toggle"
          method="post"
          hx-post="/tasks/{{ task.id }}/toggle"
          hx-target="#task-{{ task.id }}"
          hx-swap="outerHTML">
      <button type="submit"
              aria-label="{% if task.completed %}Mark task '{{ task.title }}' as to do{% else %}Mark task '{{ task.title }}' as done{% endif %}">
        {% if task.completed %}Mark to do{% else %}Mark done{% endif %}
      </button>
    </form>

    <form action="/tasks/{{ task.id }}/edit" method="get"
          hx-get="/tasks/{{ task.id }}/edit"
          hx-target="#task-{{ task.id }}"
          hx-swap="outerHTML">
      <button type="submit" aria-label="Edit task: {{ task.title }}">Edit</button>
    </form>

    {# Dual-path delete: HTMX uses DELETE on the form, no-JS uses POST fallback #}
    <form action="/tasks/{{ task.id }}/delete"
          method="post"
          style="display: inline;"
          hx-delete="/tasks/{{ task.id }}"
          hx-target="#task-{{ task.id }}"
          hx-swap="outerHTML"
          hx-confirm="Delete the task '{{ task.title }}'?">
      <button type="submit"
              aria-label="Delete task: {{ task.title }}">
        Delete
      </button>
    </form>
  </div>
</li>
