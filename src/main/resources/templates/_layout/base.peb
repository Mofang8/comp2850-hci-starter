<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}COMP2850 Task Manager{% endblock %}</title>

    {# Pico CSS for baseline accessible styles (WCAG 2.2 AA compliant) #}
    <link rel="stylesheet" href="https://unpkg.com/@picocss/pico@2/css/pico.min.css">
    <link rel="stylesheet" href="/static/css/custom.css">

    {# HTMX for progressive enhancement #}
    <script src="/static/js/htmx-1.9.12.min.js" defer></script>
</head>
<body>
    {# Include header with skip link, status region, and navigation #}
    {% include "_layout/_header.peb" %}

    {# Main landmark for screen readers (WCAG 1.3.1) #}
    {# tabindex="-1" allows programmatic focus for skip link #}
    {# Pico \"container\" class centres content and constrains width for better layout #}
    <main id="main" tabindex="-1" class="container">
        {% block content %}
        {# Page-specific content goes here #}
        {% endblock %}
    </main>

    {# Footer with helpful links and session info #}
    {% include "_layout/_footer.peb" %}
</body>
</html>
